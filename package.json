{
  "name": "joinstick",
  "version": "0.1.0",
  "description": "Use phones as gamepads for HTML5 browser games: scan a QR, play. Self-hosted and open source, no accounts, no app install.",
  "license": "MIT",
  "author": {
    "name": "Rafa Prats",
    "url": "https://github.com/raprav"
  },
  "homepage": "https://github.com/raprav/joinstick#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raprav/joinstick.git"
  },
  "bugs": {
    "url": "https://github.com/raprav/joinstick/issues"
  },
  "keywords": [
    "gamepad",
    "controller",
    "phone-controller",
    "mobile-controller",
    "phone-gamepad",
    "virtual-gamepad",
    "touch-controls",
    "local-multiplayer",
    "multiplayer",
    "party-game",
    "couch-coop",
    "smartphone-controller",
    "game-controller",
    "qr",
    "qr-code",
    "websocket",
    "html5",
    "html5-game",
    "browser-game",
    "self-hosted"
  ],
  "type": "module",
  "main": "src/server.js",
  "types": "src/server.d.ts",
  "exports": {
    ".": {
      "types": "./src/server.d.ts",
      "default": "./src/server.js"
    },
    "./host": {
      "types": "./public/host.d.ts",
      "default": "./public/host.js"
    },
    "./client": {
      "types": "./public/client.d.ts",
      "default": "./public/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "joinstick": "src/cli.js"
  },
  "files": [
    "src",
    "public",
    "llms.txt",
    "AGENTS.md",
    "PROTOCOL.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test"
  },
  "dependencies": {
    "uqr": "^0.1.3",
    "ws": "^8.22.0"
  }
}
